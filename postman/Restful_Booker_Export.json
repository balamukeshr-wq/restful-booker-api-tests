        {
          "name": "PATCH /booking/{id}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"PATCH changes only the field sent\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.firstname).to.eql(\"PATCHED-NAME\");",
                  "    pm.expect(body.lastname).to.eql(\"User\");",
                  "});"
                ]
              }
            }
