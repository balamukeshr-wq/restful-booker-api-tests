                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Updated\",\n    \"lastname\": \"User\",\n    \"totalprice\": 5000,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-10-20\",\n        \"checkout\": \"2026-10-30\"\n    },\n    \"additionalneeds\": \"Lunch\"\n}",
              "options": {
                "raw": {
                  "language": "json"
